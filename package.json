{
  "name": "larascura",
  "displayName": "LaraScura",
  "description": "Visualize Laravel architecture, follow request flows, and understand the syntax.",
  "version": "0.7.1",
  "publisher": "ooll",
  "author": {
    "name": "Ozkan A."
  },
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandaland/larascura.git"
  },
  "bugs": {
    "url": "https://github.com/brandaland/larascura/issues"
  },
  "homepage": "https://github.com/brandaland/larascura#readme",
  "icon": "media/larascura.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Education"
  ],
  "keywords": [
    "laravel",
    "php",
    "architecture",
    "routes",
    "eloquent",
    "visualization",
    "learning",
    "mind map",
    "mindmap",
    "architecture map",
    "code map",
    "diagram",
    "schema",
    "scheme",
    "dependency graph",
    "request flow",
    "request lifecycle",
    "laravel learning",
    "diagnostics",
    "linter",
    "typo",
    "inertia",
    "vue"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:artisan",
    "onCommand:larascura.openMap",
    "onView:larascura.explorer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LaraScura reads PHP source files to build a local architecture map. It never executes project code."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "larascura.openMap",
        "title": "LaraScura: Open Architecture Map",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "larascura.refresh",
        "title": "LaraScura: Refresh Architecture Map",
        "icon": "$(refresh)"
      },
      {
        "command": "larascura.explainSelection",
        "title": "LaraScura: Explain Selected Laravel Syntax",
        "icon": "$(lightbulb)"
      },
      {
        "command": "larascura.openNode",
        "title": "LaraScura: Open Source"
      },
      {
        "command": "larascura.revealInMap",
        "title": "LaraScura: Reveal in Architecture Map",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "larascura.openMethod",
        "title": "LaraScura: Open Controller Method"
      },
      {
        "command": "larascura.openFile",
        "title": "LaraScura: Open File"
      },
      {
        "command": "larascura.playJourney",
        "title": "LaraScura: Play Request Journey",
        "icon": "$(play)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "larascura",
          "title": "LaraScura",
          "icon": "media/larascura.svg"
        }
      ]
    },
    "views": {
      "larascura": [
        {
          "id": "larascura.explorer",
          "name": "Laravel Architecture"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "larascura.openMap",
          "when": "view == larascura.explorer",
          "group": "navigation@1"
        },
        {
          "command": "larascura.refresh",
          "when": "view == larascura.explorer",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "larascura.explainSelection",
          "when": "editorLangId == php && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "larascura.revealInMap",
          "when": "editorLangId == php && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "larascura.openMethod",
          "when": "false"
        },
        {
          "command": "larascura.openNode",
          "when": "false"
        },
        {
          "command": "larascura.revealInMap",
          "when": "editorLangId == php"
        },
        {
          "command": "larascura.openFile",
          "when": "false"
        },
        {
          "command": "larascura.playJourney",
          "when": "editorLangId == php"
        }
      ],
      "editor/title": [
        {
          "command": "larascura.openMap",
          "when": "resourceLangId == php && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "LaraScura",
      "properties": {
        "larascura.explanationLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "tr"
          ],
          "default": "auto",
          "description": "Language used for Laravel syntax explanations."
        },
        "larascura.watchFiles": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the map when PHP files change."
        },
        "larascura.includeRepositories": {
          "type": "boolean",
          "default": true,
          "description": "Classify repository classes as their own architecture layer."
        },
        "larascura.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show routes, middleware, and connection counts above Laravel routes, controller actions, and classes."
        },
        "larascura.doctor": {
          "type": "boolean",
          "default": true,
          "description": "Run LaraScura Doctor: report missing controller methods and views, misspelled middleware, missing models, and duplicate routes in the Problems panel, with quick fixes."
        }
      }
    },
    "colors": [
      {
        "id": "larascura.layer.route",
        "description": "Icon color for routes in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#22c55e",
          "dark": "#22c55e",
          "highContrast": "#22c55e",
          "highContrastLight": "#22c55e"
        }
      },
      {
        "id": "larascura.layer.middleware",
        "description": "Icon color for middleware in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#f59e0b",
          "dark": "#f59e0b",
          "highContrast": "#f59e0b",
          "highContrastLight": "#f59e0b"
        }
      },
      {
        "id": "larascura.layer.request",
        "description": "Icon color for Form Requests in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#f97316",
          "dark": "#f97316",
          "highContrast": "#f97316",
          "highContrastLight": "#f97316"
        }
      },
      {
        "id": "larascura.layer.controller",
        "description": "Icon color for controllers in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#3b82f6",
          "dark": "#3b82f6",
          "highContrast": "#3b82f6",
          "highContrastLight": "#3b82f6"
        }
      },
      {
        "id": "larascura.layer.page",
        "description": "Icon color for Inertia pages in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#42b883",
          "dark": "#42b883",
          "highContrast": "#42b883",
          "highContrastLight": "#42b883"
        }
      },
      {
        "id": "larascura.layer.service",
        "description": "Icon color for services in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#8b5cf6",
          "dark": "#8b5cf6",
          "highContrast": "#8b5cf6",
          "highContrastLight": "#8b5cf6"
        }
      },
      {
        "id": "larascura.layer.repository",
        "description": "Icon color for repositories in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#a855f7",
          "dark": "#a855f7",
          "highContrast": "#a855f7",
          "highContrastLight": "#a855f7"
        }
      },
      {
        "id": "larascura.layer.model",
        "description": "Icon color for models in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#ef4444",
          "dark": "#ef4444",
          "highContrast": "#ef4444",
          "highContrastLight": "#ef4444"
        }
      },
      {
        "id": "larascura.layer.job",
        "description": "Icon color for jobs in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#64748b",
          "dark": "#64748b",
          "highContrast": "#64748b",
          "highContrastLight": "#64748b"
        }
      },
      {
        "id": "larascura.layer.event",
        "description": "Icon color for events in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#eab308",
          "dark": "#eab308",
          "highContrast": "#eab308",
          "highContrastLight": "#eab308"
        }
      },
      {
        "id": "larascura.layer.listener",
        "description": "Icon color for listeners in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#14b8a6",
          "dark": "#14b8a6",
          "highContrast": "#14b8a6",
          "highContrastLight": "#14b8a6"
        }
      },
      {
        "id": "larascura.layer.provider",
        "description": "Icon color for service providers in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#ec4899",
          "dark": "#ec4899",
          "highContrast": "#ec4899",
          "highContrastLight": "#ec4899"
        }
      },
      {
        "id": "larascura.layer.command",
        "description": "Icon color for Artisan commands in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#06b6d4",
          "dark": "#06b6d4",
          "highContrast": "#06b6d4",
          "highContrastLight": "#06b6d4"
        }
      },
      {
        "id": "larascura.layer.class",
        "description": "Icon color for other classes in the LaraScura sidebar, matching the map.",
        "defaults": {
          "light": "#94a3b8",
          "dark": "#94a3b8",
          "highContrast": "#94a3b8",
          "highContrastLight": "#94a3b8"
        }
      }
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run security:check",
    "typecheck": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "security:check": "node scripts/security-check.mjs",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "package:vsix": "npx vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
